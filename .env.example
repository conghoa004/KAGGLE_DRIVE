# Kaggle File Server Configuration
# Copy this file to .env or pass as environment variables

# Root directory to manage (Defaults to / on Kaggle, or ./workspace locally)
KAGGLE_DRIVE_ROOT=/

# Server Host & Port
KAGGLE_DRIVE_HOST=127.0.0.1
KAGGLE_DRIVE_PORT=8000

# Authentication (If left empty, a secure 24-character random password will be auto-generated)
KAGGLE_DRIVE_USERNAME=admin
KAGGLE_DRIVE_PASSWORD=

# Default Interface Language: vi (Tiếng Việt), en (English), zh (简体中文)
KAGGLE_DRIVE_LANG=en

# Session Secret (Leave empty to auto-generate)
KAGGLE_DRIVE_SECRET_KEY=

# Cloudflare Tunnel Configuration
# Set to 'false' if running locally without needing public tunnel
ENABLE_CLOUDFLARE_TUNNEL=true
# Optional: If you have a named Cloudflare Tunnel, provide the tunnel token:
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_URL=


# Request and archive limits (bytes unless noted)
KAGGLE_DRIVE_MAX_UPLOAD_BYTES=5368709120
KAGGLE_DRIVE_MAX_BINARY_SAVE_BYTES=104857600
KAGGLE_DRIVE_MAX_TEXT_PREVIEW_BYTES=10485760
KAGGLE_DRIVE_MAX_REMOTE_DOWNLOAD_BYTES=5368709120
KAGGLE_DRIVE_MAX_ARCHIVE_MEMBERS=100000
KAGGLE_DRIVE_MAX_ARCHIVE_UNPACKED_BYTES=10737418240
